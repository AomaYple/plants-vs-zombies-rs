# Rust 构建产物和生成的发行文件。
/target/
/dist/
/artifacts/
/tmp/

# 排除原版可执行文件和未登记的资源包。
*.pak
*.exe
*.dll
*.dmp

# 参考资源包与解包资源一同纳入版本控制。
!/assets/original/main.pak

# 本机配置和敏感信息。
/.env
/.env.*
!/.env.example

# 编辑器和操作系统产生的文件。
/.idea/
/.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Cargo.lock 已生成并跟踪，后续由 Cargo 维护。
