# Rust and generated release artifacts.
/target/
/dist/
/artifacts/
/tmp/

# Keep original executables and unregistered packages out of Git.
*.pak
*.exe
*.dll
*.dmp

# The reference package is intentionally versioned alongside extracted assets.
!/assets/original/main.pak

# Machine-specific configuration and secrets.
/.env
/.env.*
!/.env.example

# Editors and operating systems.
/.idea/
/.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Cargo.lock is intentionally NOT ignored. Generate and commit it when the
# first Cargo package is introduced; the empty workspace has none.
